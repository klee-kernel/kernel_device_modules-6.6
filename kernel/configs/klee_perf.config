# Production Klee builds do not need sanitizer, debug-info, or PM debug
# infrastructure. Core tracing is kept at defconfig defaults because MediaTek
# modules depend on it. Keep the functional device drivers unchanged.

# Sanitizer/runtime debug overhead.
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set
# CONFIG_KASAN_GENERIC is not set
# CONFIG_KASAN_SW_TAGS is not set
# CONFIG_KASAN_INLINE is not set
# CONFIG_KASAN_STACK is not set
# CONFIG_KASAN_VMALLOC is not set
# CONFIG_MTK_KASAN_DEBUG is not set
# CONFIG_MTK_KASAN_MEMBLOCK_SKIP is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_KFENCE is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set

# Debug information and power/debug subsystems.
# Select the "None" debug-info choice explicitly; the GKI defconfig
# otherwise leaves DWARF5 debug information enabled.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_COMPRESSED_ZSTD is not set

# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_PROFILING is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_ADVANCED_DEBUG is not set
# CONFIG_PM_SLEEP_DEBUG is not set

# Core tracing, tracepoint, and probe configs stay at defconfig defaults.
# MediaTek vendor modules use vendor hooks and module tracepoint registration
# (including AEE), and the defconfig probe options are what select TRACING
# and its dependencies. Stripping them broke the customer-modules build.
